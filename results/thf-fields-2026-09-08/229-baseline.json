      "status": "estimate",
      "isotopologue": "229Th19F+",
      "convention": null,
      "note": "Transferred unchanged from 232Th19F+ to 229Th19F+; not measured for the target isotope and not mass-scaled. Source-isotope uncertainty: 0.12 kHz; target-isotope transfer uncertainty is unquantified. "
    },
    "omega_ef": {
      "value": 5.29,
      "unit": "MHz",
